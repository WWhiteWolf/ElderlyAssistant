<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Reminder shape" id="reminder-shape-1">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="A Place To Remember — the reminder path" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One shape, designed once. The scheduler is the engine; everything else is packaging and screens." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="dropped" value="Dropped&#10;nothing is armed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="screens" value="Input screens&#10;&lt;i&gt;pages and pop-ups&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="instore" value="Input store&#10;&lt;i&gt;item · when it comes due · lead times&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="180" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="wanted" value="Is this still wanted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="scheduler" value="Scheduler&#10;&lt;i&gt;the engine&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="710" y="180" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="depth" value="How far ahead do we arm?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="920" y="160" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="outstore" value="Output store&#10;&lt;i&gt;WantedReminder&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1160" y="180" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="phone" value="The phone&#10;&lt;i&gt;banner and buttons&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1400" y="180" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="siri" value="Siri, and the app itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="screens" target="instore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="siri" target="instore">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="325" />
              <mxPoint x="220" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="instore" target="wanted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;dashed=1;strokeColor=#999999;fontColor=#666666;" edge="1" parent="1" source="wanted" target="dropped">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="wanted" target="scheduler">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="scheduler" target="depth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="the next few moments" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="depth" target="outstore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="1" source="outstore" target="phone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="done · snoozed · skipped · fired" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="phone" target="wanted">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1475" y="430" />
              <mxPoint x="565" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note1" value="The two stores are the contracts. One shape going in means every screen writes the same thing.&#10;One shape coming out means the reminder side reads the same thing." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="700" height="50" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="The returning arrow comes back to the same block the store feeds, so anything written down flows on by construction.&#10;Nothing has to remember to set the loop turning." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="770" y="470" width="780" height="50" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="Depth belongs to the scheduler, not the item — only the scheduler can see how full the phone is." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="920" y="290" width="420" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
