<mxfile host="Electron">
  <diagram name="Reminder shape" id="reminder-shape-1">
    <mxGraphModel dx="1592" dy="891" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" value="A Place To Remember — the reminder path" vertex="1">
          <mxGeometry height="30" width="600" x="230" y="10" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#666666;" value="One shape, designed once. The scheduler is the engine; everything else is packaging and screens." vertex="1">
          <mxGeometry height="24" width="900" x="230" y="40" as="geometry" />
        </mxCell>
        <mxCell id="dropped" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;" value="Dropped&#xa;nothing is armed" vertex="1">
          <mxGeometry height="50" width="170" x="670" y="60" as="geometry" />
        </mxCell>
        <mxCell id="screens" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Input screens&#xa;&lt;i&gt;pages and pop-ups&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="150" x="230" y="170" as="geometry" />
        </mxCell>
        <mxCell id="instore" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Input store&#xa;&lt;i&gt;item · when it comes due · lead times&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="180" x="440" y="170" as="geometry" />
        </mxCell>
        <mxCell id="wanted" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" value="Is this still wanted?" vertex="1">
          <mxGeometry height="100" width="170" x="670" y="150" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1" value="Scheduler&#xa;&lt;i&gt;the engine&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="150" x="900" y="170" as="geometry" />
        </mxCell>
        <mxCell id="depth" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" value="How far ahead do we arm?" vertex="1">
          <mxGeometry height="100" width="170" x="1110" y="150" as="geometry" />
        </mxCell>
        <mxCell id="outstore" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="Output store&#xa;&lt;i&gt;WantedReminder&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="170" x="1350" y="170" as="geometry" />
        </mxCell>
        <mxCell id="phone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="The phone&#xa;&lt;i&gt;banner and buttons&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="150" x="1590" y="170" as="geometry" />
        </mxCell>
        <mxCell id="siri" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="Siri, and the app itself" vertex="1">
          <mxGeometry height="50" width="150" x="230" y="290" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="screens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="instore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="siri" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="instore">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="315" />
              <mxPoint x="410" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="instore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="wanted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="wanted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;dashed=1;strokeColor=#999999;fontColor=#666666;" target="dropped" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="wanted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="scheduler" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="scheduler" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="depth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="depth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="outstore" value="the next few moments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="outstore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" target="phone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="phone" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" target="wanted" value="done · snoozed · skipped · fired">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1665" y="420" />
              <mxPoint x="755" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note1" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#666666;" value="The two stores are the contracts. One shape going in means every screen writes the same thing.&#xa;One shape coming out means the reminder side reads the same thing." vertex="1">
          <mxGeometry height="50" width="700" x="230" y="460" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#b85450;" value="The returning arrow comes back to the same block the store feeds, so anything written down flows on by construction.&#xa;Nothing has to remember to set the loop turning." vertex="1">
          <mxGeometry height="50" width="780" x="960" y="460" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#666666;" value="Depth belongs to the scheduler, not the item — only the scheduler can see how full the phone is." vertex="1">
          <mxGeometry height="40" width="420" x="1110" y="280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
